# Единый шаблон настроек Nuvio.
# Скопируйте его в .secrets/.env и заполните значения:
#   mkdir -p .secrets
#   cp .env.example .secrets/.env
#
# Запускайте Compose с этим же файлом:
#   docker compose --env-file .secrets/.env up -d

# =============================================================================
# ОБЯЗАТЕЛЬНЫЕ ПЕРЕМЕННЫЕ
# =============================================================================

# Токен бота от @BotFather.
TELEGRAM_TOKEN=

# ID администраторов через запятую. Узнать свой ID можно у @userinfobot.
ADMIN_IDS=

# Учётные данные приложения Telegram для локального Bot API.
# Получить на https://my.telegram.org в разделе API development tools.
# Это НЕ токен бота и НЕ данные пользовательского аккаунта.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# =============================================================================
# WEB UI
# =============================================================================

WEB_USERNAME=admin
WEB_PASSWORD=changeme

# Постоянный ключ подписи сессий, рекомендуется 32+ случайных байта.
# Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
WEB_SECRET_KEY=
WEB_PORT=8080

FAIL2BAN_RETRIES=5
FAIL2BAN_TIME=10m

# =============================================================================
# ЗАГРУЗКА И ОБРАБОТКА
# =============================================================================

LOG_LEVEL=INFO
DOWNLOAD_WORKERS=8
BLOCKING_TASK_TIMEOUT=600

# Быстрый путь TikTok: прямая ссылка на H.264 со звуком вместо yt-dlp.
# Снимает перекодирование HEVC (до 9.5 с на минутном ролике), но отдаёт
# 576x1024 вместо 1080p. При отказе резолвера происходит откат на yt-dlp.
#
# ВАЖНО: смена флага не влияет на уже закэшированные ссылки. Кэш file_id
# читается до скачивания и живёт 90 дней, поэтому после TIKTOK_FAST_PATH=false
# ранее обработанные URL продолжат отдавать 576x1024. Админская команда
# /cleanup_cache удаляет только записи старше 90 дней и такой откат не даёт —
# для немедленного сброса удалите файл кэша telegram_cache.db (каталог
# DATA_DIR) или отправьте ссылку, которой в кэше ещё нет.
TIKTOK_FAST_PATH=true

# Быстрый путь Instagram: прямая ссылка из GraphQL вместо yt-dlp.
# Instagram отдаёт H.264 + AAC, поэтому качество не меняется, а скачивание
# на замерах заняло ~1.9 с вместо 7.5 с. При отказе GraphQL — откат на yt-dlp.
# Ускоряет и аудио: оно извлекается из уже скачанного видео.
INSTAGRAM_FAST_PATH=true

# Автообновление меняет проверенную версию внутри контейнера и потому выключено.
# Включайте осознанно, если нужен rolling-release. Каналы: stable, nightly, master.
YTDLP_AUTO_UPDATE=false
YTDLP_RELEASE_CHANNEL=nightly
YTDLP_AUTO_UPDATE_TIMEOUT=240
YTDLP_CLI_FALLBACK=true
YTDLP_CLI_TIMEOUT=900

# =============================================================================
# ДОПОЛНИТЕЛЬНЫЕ НАСТРОЙКИ
# =============================================================================

# Тег готового образа Nuvio для compose.yaml.
TAG=latest

# Пути внутри контейнера. Обычно менять не требуется.
YOUTUBE_COOKIES_FILE=/app/.secrets/www.youtube.com_cookies.txt
INSTAGRAM_COOKIES_FILE=/app/.secrets/www.instagram.com_cookies.txt
TIKTOK_COOKIES_FILE=/app/.secrets/www.tiktok.com_cookies.txt

# TELEGRAM_LOCAL_MODE, адрес локального Bot API, TEMP_DIR и допустимый размер
# файла задаются в compose.yaml, чтобы контейнеры использовали единый том.
